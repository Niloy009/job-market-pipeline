# GCP / BigQuery
# Path to your GCP service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET_ID=raw_jobs
BQ_TABLE_ID=postings

# Bundesagentur fur Arbeit API
# API key is public: jobboerse-jobsuche (no registration needed)
API_BASE_URL=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service/pc/v4/jobs
DETAIL_BASE_URL=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service/pc/v4/jobdetails
API_KEY=jobboerse-jobsuche

# Job search defaults
DEFAULT_KEYWORD=data engineer
DEFAULT_LOCATION=Deutschland

# Airbyte OSS
# Install and start Airbyte locally:
#   brew install airbytehq/tap/abctl
#   abctl local install
#   abctl local credentials   ← get your username and password from here
#
# After Airbyte is running at http://localhost:8000:
#   1. Import airbyte/bundesagentur_source.yaml as a custom connector
#   2. Create a BigQuery destination using your service account JSON
#   3. Create a connection between source and destination
#   4. Copy the UUID from the URL bar: http://localhost:8000/connections/<uuid>/status
AIRBYTE_CONNECTION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AIRBYTE_HOST=localhost
AIRBYTE_PORT=8000
AIRBYTE_USERNAME=your-airbyte-email
AIRBYTE_PASSWORD=your-airbyte-password
